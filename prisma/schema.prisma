generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  RECU
  EN_COURS
  TERMINE
  LIVRE
  ANNULE
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
  CREDIT
}

enum ExpenseCategory {
  LOYER
  SALAIRE
  FOURNITURE
  MAINTENANCE
  LOGISTIQUE
  AUTRE
}

enum StaffRole {
  ADMIN
  CAISSIER
}

/// Rôle plateforme du titulaire du compte (tenant vs super-admin back-office).
enum UserRole {
  USER
  SUPERADMIN
}

enum SubscriptionPlan {
  DEMO
  STARTER
  PRO
  BUSINESS
}

enum ReportProblemKind {
  BUG_TECHNIQUE
  CONNEXION_COMPTE
  CAISSE_COMMANDE
  IMPRESSION_SCANNER
  SUGGESTION
  AUTRE
}

enum NotificationPriority {
  INFO
  REMINDER
  CRITICAL
}

enum NotificationCategory {
  SECURITY_AUDIT
  OPERATIONS
  CALENDAR
  SMART_ALERT
  BILLING
}

model User {
  id                  String            @id @default(cuid()) @map("_id")
  name                String
  email               String            @unique
  passwordHash        String
  phone               String
  city                String
  employeeCount       Int
  laundryCount        Int
  role                UserRole          @default(USER)
  plan                SubscriptionPlan  @default(DEMO)
  lastLogin           DateTime?
  emailVerified       DateTime?
  storeClosingTime    String?
  expenseAlertRatio   Float?    @default(0.4)
  cashReserveAmount   Float?    @default(0)
  cashClosureTimePref String?
  cashWorkDays        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  categories          Category[]
  clients             Client[]
  orders              Order[]
  providers           Provider[]
  expenses            Expense[]
  appReports          AppReport[]
  notifications       Notification[]
  cancelledOrders     CancelledOrderAudit[]
  cashClosures        CashClosure[]
  calendarEvents      CalendarEvent[]
  staffAccounts       StaffAccount[]
}

model StaffAccount {
  id           String    @id @default(cuid()) @map("_id")
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  role         StaffRole @default(CAISSIER)
  passwordHash String
  pageAccess   Json?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, role])
  @@index([userId, createdAt])
}

model AppReport {
  id        String            @id @default(cuid()) @map("_id")
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      ReportProblemKind
  message   String
  createdAt DateTime          @default(now())

  @@index([userId, createdAt])
}

model Category {
  id        String    @id @default(cuid()) @map("_id")
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  nameAr    String?
  icon      String
  isActive  Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model Product {
  id          String                 @id @default(cuid()) @map("_id")
  name        String
  nameAr      String?
  barcode     String                 @unique
  imageUrl    String?
  basePrice   Float
  isActive    Boolean                @default(true)
  categoryId  String
  category    Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  options     ProductServiceOption[]
  orderItems  OrderItem[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([categoryId])
}

model ProductServiceOption {
  id            String  @id @default(cuid()) @map("_id")
  label         String
  labelAr       String?
  priceModifier Float   @default(0)
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Client {
  id          String   @id @default(cuid()) @map("_id")
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  phone       String?
  email       String?
  storeCredit Float    @default(0)
  totalOrders Int      @default(0)
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([userId, phone])
  @@index([userId, email])
}

model Order {
  id            String        @id @default(cuid()) @map("_id")
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderNumber   String        @unique
  status        OrderStatus   @default(RECU)
  paymentMethod PaymentMethod
  total         Float
  dueDate       DateTime
  cashierId     String
  clientId      String?
  client        Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId, status, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([cashierId, createdAt])
}

model Notification {
  id        String               @id @default(cuid()) @map("_id")
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationCategory
  priority  NotificationPriority @default(INFO)
  title     String
  message   String
  isRead    Boolean              @default(false)
  link      String?
  dedupeKey String?
  metadata  Json?
  createdAt DateTime             @default(now())

  @@index([userId, createdAt])
  @@index([userId, isRead, createdAt])
}

model CancelledOrderAudit {
  id           String   @id @default(cuid()) @map("_id")
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId      String
  orderNumber  String
  reason       String
  actorId      String
  lostAmount   Float
  cancelledAt  DateTime @default(now())
  metadata     Json?

  @@index([userId, cancelledAt])
}

model CashClosure {
  id            String   @id @default(cuid()) @map("_id")
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  closureDate   DateTime
  closedAt      DateTime @default(now())
  revenueTotal  Float    @default(0)
  expenseTotal  Float    @default(0)
  countedAmount Float?
  expectedNet   Float    @default(0)
  difference    Float    @default(0)
  comment       String?

  @@index([userId, closureDate])
}

model CalendarEvent {
  id               String    @id @default(cuid()) @map("_id")
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  start            DateTime
  end              DateTime
  allDay           Boolean   @default(false)
  color            String
  location         String?
  description      String?
  guests           String?
  reminder         String?
  reminder15SentAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, start])
}

model OrderItem {
  id          String   @id @default(cuid()) @map("_id")
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName String
  optionLabel String
  quantity    Int
  unitPrice   Float
  lineTotal   Float
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model Provider {
  id        String    @id @default(cuid()) @map("_id")
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  category  String?
  expenses  Expense[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

model Expense {
  id          String          @id @default(cuid()) @map("_id")
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  amount      Float
  category    ExpenseCategory @default(AUTRE)
  expenseDate DateTime
  notes       String?
  providerId  String?
  provider    Provider?       @relation(fields: [providerId], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId, expenseDate, category])
  @@index([expenseDate, category])
 }

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}