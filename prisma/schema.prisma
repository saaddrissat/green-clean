generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  RECU
  EN_COURS
  TERMINE
  LIVRE
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
}

enum ExpenseCategory {
  LOYER
  SALAIRE
  FOURNITURE
  MAINTENANCE
  LOGISTIQUE
  AUTRE
}

model Category {
  id        String    @id @default(cuid()) @map("_id")
  name      String    @unique
  icon      String
  isActive  Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          String                 @id @default(cuid()) @map("_id")
  name        String
  barcode     String                 @unique
  imageUrl    String?
  basePrice   Float               
  isActive    Boolean                @default(true)
  categoryId  String
  category    Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  options     ProductServiceOption[]
  orderItems  OrderItem[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([categoryId])
}

model ProductServiceOption {
  id            String   @id @default(cuid()) @map("_id")
  label         String
  priceModifier Float  @default(0) 
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Client {
  id          String   @id @default(cuid()) @map("_id")
  fullName    String
  phone       String?  @unique
  email       String?  @unique
  totalOrders Int      @default(0)
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id            String        @id @default(cuid()) @map("_id")
  orderNumber   String        @unique
  status        OrderStatus   @default(RECU)
  paymentMethod PaymentMethod
  total         Float       
  dueDate       DateTime
  cashierId     String
  clientId      String?
  client        Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([cashierId, createdAt])
}

model OrderItem {
  id               String   @id @default(cuid()) @map("_id")
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName      String
  optionLabel      String
  quantity         Int
  unitPrice        Float  
  lineTotal        Float  
  createdAt        DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model Provider {
  id        String    @id @default(cuid()) @map("_id")
  name      String
  phone     String?
  email     String?
  expenses  Expense[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Expense {
  id          String          @id @default(cuid()) @map("_id")
  title       String
  amount      Float         
  category    ExpenseCategory @default(AUTRE)
  expenseDate DateTime
  notes       String?
  providerId  String?
  provider    Provider?       @relation(fields: [providerId], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([expenseDate, category])
}
