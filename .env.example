# Prisma datasource is MongoDB (see prisma/schema.prisma).
# Example local:
# DATABASE_URL="mongodb://127.0.0.1:27017/green_clean"
# Atlas:
# DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/green_clean?retryWrites=true&w=majority"

# Code d'accès affiché avant la page de connexion (optionnel, défaut en dev : 157294386).
# SITE_GATE_PASSWORD=157294386

# JWT / session (min 32 caractères). En local, un secret de dev est utilisé si absent.
# En production, ce champ est obligatoire (obligatoire sur Vercel : sans lui le build/runtime échoue via lib/env.ts).
# openssl rand -base64 32
# AUTH_SECRET=

# Optionnel — rappel clôture caisse si pas d’heure en base utilisateur (voir aussi Paramètres).
# GC_STORE_CLOSING_HOUR=20:00

# SMTP (envoi facture email)
# Gmail: host=smtp.gmail.com port=587 secure=false (ou 465/true), user=adresse Gmail,
# pass=mot de passe d'application Google (pas le mot de passe normal du compte).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=votre-adresse@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_FROM="Green Clean <votre-adresse@gmail.com>"

# --- Déploiement Vercel ---
# Dans le dashboard Projet → Settings → Environment Variables, ajoutez au minimum :
#   DATABASE_URL   (même chaîne Atlas qu’en prod, avec utilisateur DB dédié si possible)
#   AUTH_SECRET    (32+ caractères, différent du local)
# Framework : Next.js. Si le repo contient plusieurs dossiers, définissez "Root Directory"
# sur le dossier de cette app (ex. green clean).
# MongoDB Atlas → Network Access : autoriser 0.0.0.0/0 (ou les IP sortantes Vercel si vous les restreignez).
# Schéma DB : depuis votre machine, avec DATABASE_URL prod : npm run prisma:push
# (ou une fois en CI avant/après déploiement).

